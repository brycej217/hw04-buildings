# ==========================================
# Houdini Specifics
# ==========================================
# Exclude automatic backup directories
**/backup/
*/backup/*

# Exclude temporary crash recovery and log files
houdini_crash.*
*.log
*.ifd

# Exclude asset definition backups (if embedding otls/hdas)
houdini/otls/backup/

# ==========================================
# Render & Simulation Caches (Highly Recommended)
# ==========================================
# Exclude simulation caches and geometry bgeo dumps
*.bgeo
*.bgeo.*
*.sim
*.sc
*.abc
*.vdb
*.fbx
*.obj

# ==========================================
# Python & Compiled Code
# ==========================================
# Exclude Python byte-code and caches generated by shelf tools or panels
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ==========================================
# OS & IDE Overheads
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace